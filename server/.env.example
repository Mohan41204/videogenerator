PORT=5000

ENABLE_MULTILINGUAL_AUDIO=true

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=sky-meet-01-video-generator
GCS_SIGNED_URL_EXPIRATION_HOURS=24

GOOGLE_CLOUD_PROJECT=sky-meet-01
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-cloud-service-account.json
