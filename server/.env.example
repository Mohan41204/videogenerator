PORT=5000

ENABLE_MULTILINGUAL_AUDIO=true

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=sky-meet-01-video-generator
GCS_SIGNED_URL_EXPIRATION_HOURS=24

# Google Cloud Project & Location
GOOGLE_CLOUD_PROJECT=sky-meet-01
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Cloud Run Job Configuration
CLOUD_RUN_JOB_NAME=video-generator-job
CLOUD_RUN_JOB_REGION=asia-south1
FORCE_LOCAL_JOB=false
ALLOW_LOCAL_FALLBACK=true

# Renderer & Puppeteer Configuration
VIDEO_RENDER_FPS=3
PUPPETEER_EXECUTABLE_PATH=

# Application Default Credentials (Local only - Cloud Run uses attached Service Account)
GOOGLE_APPLICATION_CREDENTIALS=
